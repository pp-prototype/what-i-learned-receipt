{
  "name": "what-i-learned-receipt",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node ./scripts/serve.mjs",
    "build": "npm run build:app && npm run build:css",
    "build:app": "node ./scripts/build.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/assets/styles.css --minify",
    "check": "npm run build && node ./scripts/security-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "tailwindcss": "3.4.19"
  }
}
